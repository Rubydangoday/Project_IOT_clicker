[Unit]
Description=ARS bridge — gateway USB (serial) <-> MQTT
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
User=ars
Group=ars
SupplementaryGroups=dialout
WorkingDirectory=/opt/ars-server
Environment=ARS_CONFIG=/opt/ars-server/config.ini
Environment=PYTHONUNBUFFERED=1
# chưa cắm gateway thì bridge tự thử lại mỗi 2 s, không lỗi
ExecStart=/usr/bin/python3 /opt/ars-server/server/bridge/bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
