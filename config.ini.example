; Cấu hình chung cho bridge.py, ingest.py và web PHP.
; Chép thành config.ini rồi sửa mật khẩu. Không đưa config.ini lên GitHub.

[db]
host = 127.0.0.1
port = 3306
name = ars
user = ars
password = doi_mat_khau_nay

[mqtt]
host = 127.0.0.1
port = 1883

[gateway]
; V3.12 BLE GATT ignores room below and reads Room from the remote.
; mã lớp (room) mà laptop này phục vụ — trùng với room_id của lớp trên web
room = 1
; (chỉ khi dùng gateway nRF52840 cắm USB — bridge.py) cổng USB: Windows "COM5", Linux "/dev/ttyACM0"
serial = COM5
baud = 115200

[ble]
; V3.11 GATT: optional fixed MAC, strongly recommended after --scan
remote_address =
remote_name = ARS_REMOTE_01
; The advertise/company_id settings below apply only to legacy ble_scan.py.
; Thu sóng Remote bằng Bluetooth của laptop (bridge/ble_scan.py, dịch vụ ars-ble)
adapter = hci0
; mã công ty trong Manufacturer Data mà firmware Remote dùng (0xFFFF = mã thử nghiệm)
company_id = 0xFFFF
; 1 = phát beacon trạng thái (câu đang mở, điểm danh, xác nhận) về Remote — chỉ Linux/BlueZ; 0 = chỉ nghe
advertise = 1

[ingest]
; pin dưới mức này (mV) thì web cảnh báo "pin yếu"
low_batt_mv = 2600
; phát lại STATE định kỳ (giây) dù không có gì thay đổi
state_refresh_s = 5

[storage]
; thư mục lưu file bài giảng (Ubuntu: installer tạo /var/lib/ars/uploads). Bỏ trống = ars-server/data/uploads
; uploads = /var/lib/ars/uploads
